{
  "name": "@lfg-dev/react",
  "version": "0.1.84",
  "description": "Embeddable React surfaces for LFG.",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && bun x tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css"
  },
  "dependencies": {
    "@lfg-dev/client": "workspace:*",
    "@lfg-dev/protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BennyKok/omg.dev.git",
    "directory": "packages/react"
  }
}
