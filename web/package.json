{
  "name": "@omg-dev/app",
  "version": "0.1.91",
  "description": "The full OMG application surface for React hosts.",
  "license": "MIT",
  "homepage": "https://omg.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/BennyKok/omg.dev.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/BennyKok/omg.dev/issues"
  },
  "files": [
    "dist-lib"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./styles.css": "./dist-lib/styles.css"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts && cp src/embedded.d.ts dist-lib/index.d.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omg-dev/client": "workspace:*",
    "@ai-sdk/react": "^4.0.19",
    "@base-ui/react": "^1.3.0",
    "@number-flow/react": "^0.6.2",
    "@pierre/diffs": "^1.3.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-router": "^1.170.18",
    "ai": "^7.0.18",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "diff": "^9.0.0",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss-prefix-selector": "^2.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.0",
    "vite": "^6.0.7"
  },
  "publishConfig": {
    "access": "public"
  }
